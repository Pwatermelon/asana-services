# ============================================
# База данных PostgreSQL
# ============================================
POSTGRES_DB=asana_db
POSTGRES_USER=asana_user
POSTGRES_PASSWORD=asana_password_123

# ============================================
# Пользователи по умолчанию
# ============================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

EXPERT_USERNAME=expert
EXPERT_PASSWORD=expert123

GUEST_USERNAME=guest
GUEST_PASSWORD=guest123

# ============================================
# JWT настройки
# ============================================
SECRET_KEY=your-super-secret-key-change-this-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================
# SMTP настройки для отправки писем
# ============================================
SMTP_HOST=mailu-front
SMTP_PORT=587
SMTP_USER=noreply@your-domain.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@your-domain.com
SMTP_FROM_NAME=Каталог Асан
