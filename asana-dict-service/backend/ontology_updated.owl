    <rdf:type rdf:resource="http://www.semanticweb.org/platinum_watermelon/ontologies/Asana#AsanaName"/>
    <asana:nameInRussian>Гомукхасана</asana:nameInRussian>
    <asana:nameInSanskrit>गोमुखासन</asana:nameInSanskrit>
    <asana:nameInTranslit>gomukhāsana</asana:nameInTranslit>
    <asana:OWLDataProperty_c8100b71_09ff_49ec_8fbf_63fa1be3947a>поза коровьей морды (названа скорее всего не по реальной коровьей морде, а по музыкальному духовому инструменту с таким название, оплетавшего человека трубами как валторна)</asana:OWLDataProperty_c8100b71_09ff_49ec_8fbf_63fa1be3947a>
  </rdf:Description>
