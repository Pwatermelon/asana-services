# ============================================
# Общие настройки базы данных PostgreSQL
# ============================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=asana_db
DB_USER=asana_user
DB_PASSWORD=asana_password

# ============================================
# Настройки для asana-server-module
# ============================================
# Хост и порт сервера
HOST_SERVER=0.0.0.0
PORT_SERVER=8000

# адрес до сервиса с нейронкой
URL_NETWORK_SERVER=http://server-network:8001

# Секретный ключ для JWT токенов (ОБЯЗАТЕЛЬНО изменить в продакшене!)
SECRET_KEY=your_secret_key_change_this_in_production

# Хост для нейронной сети (если используется)
HOST_NETWORK_SERVER=0.0.0.0
PORT_NETWORK_SERVER=8001

# Настройки SMTP для отправки email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yoga.network.project@gmail.com
SMTP_PASSWORD=ozhg ykhk ltih ddng

# MINIO S3 хранилище
HOST_MINIO=minio
PORT_MINIO=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
NAME_BUCKET_IMAGES_MINIO=images

# CORS origins - разрешенные домены для запросов к server-module
# * - разрешить все (для разработки)
# или через запятую: http://domain1.com,http://domain2.com
CORS_ORIGINS=*

# ============================================
# Настройки для asana-dict-service (backend)
# ============================================
# URL сервиса авторизации (server-module)
AUTH_SERVICE_URL=http://server-module:8000

# Настройки JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Настройки пользователей по умолчанию (для dict-service)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
EXPERT_USERNAME=expert
EXPERT_PASSWORD=expert123
GUEST_USERNAME=guest
GUEST_PASSWORD=guest123
OWL_MIGRATE_STAGING_PHOTOS_ON_START=true